## 🌤️ 里程碑三：穿透死局——商业版 HTTPS 洛阳天气小电视

在将 NTP 时间与城市实时天气合流的过程中，项目经历了极其惊险的“应用层死局对抗”。

### 🛑 经典深坑复盘
1. **语法错误**：在 `loop()` 中声明字符串缓冲区时手误写成了单字节 `char`，导致 `sprintf` 报错 `invalid conversion from 'char' to 'char*'`。修复方案为将其修正为明确分配内存的字符数组 `char timeStr[32];`。
2. **函数拼写错误**：U8g2 绘制水平线的标准函数为简写 `drawHLine`，误写为全称 `drawHorizontalLine` 导致编译失败。
3. **心知天气 -1 (Connection Refused) 死局**：由于心知天气全面收紧安全策略并强推 HTTPS，导致基础 `HTTPClient` 在没有证书链时连接直接崩塌。
4. **域名与项目级别错配（核心转折点）**：随后我们果断转投对极客更包容的**【和风天气】**平台，并且**顺手购买并充值了其尊贵的「商业版API」**。由于商业版和免费版在服务器域名上有严格红线：
   * 免费开发版域名：`://qweather.com`
   * 尊贵商业版域名：`://qweather.com`
   
   最初代码由于漏掉了 `api.` 头部且缺失了核心请求路径 `/v7/weather/now?location=` 导致疯狂返回 `-1` 错误。在历经反复核对和纠正后，最终的 HTTPS 加密 URL 得以完美确立。

### 💻 终极完美闭环代码（NTP时钟 + 洛阳商业版HTTPS天气）
本代码不仅实现了**分频刷新架构**（时间 1 秒刷新以确保秒针不卡顿；天气 30 分钟后台静默请求以防止高频刷新被封号），还引入了 `WiFiClientSecure` 并开启 `setInsecure()` 盲信任机制，利用 ESP32-S3 满血版强大的算力，成功**通过 443 加密端口完美穿透任何局域网防火墙拦截**。

```cpp
#include <Arduino.h>
#include <WiFi.h>
#include <WiFiClientSecure.h> // 核心：加密安全连接客户端
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <time.h>
#include <U8g2lib.h>

// 严格对齐你完美的硬件 SPI 引脚配置
U8G2_SH1106_128X64_NONAME_F_4W_HW_SPI u8g2(U8G2_R0, /* cs=*/ 6, /* dc=*/ 5, /* reset=*/ 4);

// 🛠 1. 填入你的 Wi-Fi 信息
const char* ssid     = "你的WiFi名称";
const char* password = "你的WiFi密码";

// 🛠 2. 粘贴你购买充值的【和风天气商业版 KEY】
const char* qweather_key = "这里填入你的商业版KEY"; 
const char* location_id  = "101180901"; // 洛阳核心区城市代码

// 全局变量：存放数据与定时器
String weather_text = "Wait..";
String weather_temp = "--";
unsigned long lastWeatherCheck = 0;
const unsigned long weatherInterval = 30 * 60 * 1000; // 后台 30 分钟分频刷新天气

const long  gmtOffset_sec = 8 * 3600;            // 北京时间东八区
const int   daylightOffset_sec = 0;              

void updateWeather() {
  if (WiFi.status() != WL_CONNECTED) return;
  
  WiFiClientSecure client;
  client.setInsecure(); // 盲信任加密握手，免去单片机配置根证书的繁琐流程
  
  HTTPClient http;
  
  // ⚡ 钞能力专线：精准拼接的尊贵商业版 https 安全信道接口 URL
  String url = "https://://qweather.com/v7/weather/now?location=" + String(location_id) + "&key=" + String(qweather_key) + "&lang=en";
  
  Serial.println("[HTTPS] 正在向和风天气【商业版通道】请求洛阳数据...");
  
  if (http.begin(client, url)) {
    http.setTimeout(8000); // 放宽加密握手超时保护至 8 秒
    int httpCode = http.GET();
    
    if (httpCode == HTTP_CODE_OK) {
      String payload = http.getString();
      Serial.println("[HTTPS] 成功收到商业版专属原始数据:");
      Serial.println(payload);
      
      // 使用 ArduinoJson 库高效清洗解压后的数据
      DynamicJsonDocument doc(2048);
      DeserializationError error = deserializeJson(doc, payload);
      
      if (!error) {
        JsonObject nowObj = doc["now"];
        const char* text = nowObj["text"]; // 提取天气状态（如 Sunny, Rain）
        const char* temp = nowObj["temp"]; // 提取实时摄氏度
        
        weather_text = String(text);
        weather_temp = String(temp);
        Serial.printf("【解析成功】洛阳当前天气: %s, 温度: %s°C\n", text, temp);
      } else {
        Serial.print("JSON 解析失败: ");
        Serial.println(error.c_str());
      }
    } else {
      Serial.printf("[HTTPS] 请求失败，网络错误码: %d\n", httpCode);
    }
    http.end();
  }
}

void setup() {
  Serial.begin(115200);
  delay(500); 
  
  u8g2.begin();
  u8g2.setBusClock(8000000); // 恢复 8MHz 高速 SPI 驱动
  
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(10, 25, "Connecting Wi-Fi...");
  u8g2.sendBuffer();
  
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  // ⚡ 200ms 高频检测极速连网
  while (WiFi.status() != WL_CONNECTED) {
    delay(200); 
    Serial.print(".");
  }
  Serial.println("\nWi-Fi Connected!");
  
  u8g2.clearBuffer();
  u8g2.drawStr(10, 25, "Wi-Fi Connected!");
  u8g2.drawStr(10, 45, "Syncing NTP Time...");
  u8g2.sendBuffer();
  
  // ⚡ 200ms 并发多 NTP 服务器高频极速时间对齐
  configTime(gmtOffset_sec, daylightOffset_sec, "://aliyun.com", "://aliyun.com", "pool.ntp.org");
  
  struct tm timeinfo;
  while (!getLocalTime(&timeinfo)) {
    delay(200); 
  }
  Serial.println("Time Synced successfully!");
  
  delay(2000); // 留出 2 秒网络管道完全就绪的平稳期
  updateWeather(); // 开机强制首次获取天气
  lastWeatherCheck = millis();
}

void loop() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return;

  // 天气定时循环触发器
  if (millis() - lastWeatherCheck >= weatherInterval) {
    updateWeather();
    lastWeatherCheck = millis();
  }

  // 分配 32 字节真实字符数组空间（完美避坑语法报错）
  char timeStr[32];   
  char dateStr[32];   
  sprintf(timeStr, "%02d:%02d:%02d", timeinfo.tm_hour, timeinfo.tm_min, timeinfo.tm_sec);
  sprintf(dateStr, "%04d-%02d-%02d", timeinfo.tm_year + 1900, timeinfo.tm_mon + 1, timeinfo.tm_mday);

  u8g2.clearBuffer();
  
  // UI 渲染 - 区域 1：顶部日期与分割线
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(32, 12, dateStr);
  u8g2.drawHLine(0, 15, 128); 
  
  // UI 渲染 - 区域 2：中央超大精美数字时间
  u8g2.setFont(u8g2_font_logisoso20_tn);
  u8g2.drawStr(12, 43, timeStr);
  u8g2.drawHLine(0, 48, 128); 
  
  // UI 渲染 - 区域 3：底部挂载洛阳商业版实时天气数据
  u8g2.setFont(u8g2_font_5x8_tf);
  u8g2.drawStr(4, 60, "LY:");
  u8g2.drawStr(22, 60, weather_text.c_str()); // 动态天气文字（如 Sunny, Rain, Overcast 等）
  
  String temp_display = weather_temp + "C";
  u8g2.drawStr(100, 60, temp_display.c_str()); // 动态实时温度
  
  u8g2.sendBuffer();
  delay(1000); // 严格维持 1 秒循环，确保秒针完美匀速跳动
}
```

